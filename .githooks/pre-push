#!/usr/bin/env bash
# Iron rule 6's static half, moved from prose into the push itself.
#
# WHY (GH #213, director ruling 2026-08-26T19:xxZ, option 甲).
#
# GH #205 made the gate RUNNABLE (`tools/agent/luacheck_gate.sh`: buys
# `lua-check` in 5.5s, runs in 13s, exits 0/2/3).  It did not make it RUN.
# Rule 6 stayed an obligation written in prose, and this repo has measured four
# times what prose costs:
#
#   GH #113  detector exists, nobody runs it            -> 开工自检 (rule 10)
#   GH #171  selfcheck's Lua leg exists, cannot run     -> buy lua5.1 (4s)
#   GH #205  rule 6's static gate exists, cannot run    -> buy lua-check (5.5s)
#   GH #213  rule 6's static gate runs, nobody runs it  -> THIS FILE
#
# The push path in .claude/rules/claude-code.md had nothing between the author
# and `origin/main`.  Now it has this.  A gate that blocks is the difference
# between an omission being SILENT and being an ACT: `RULE6_BYPASS=1` still gets
# you through a dead container, but you have to type it, and it prints a line
# you are expected to quote in your report.  That is the whole design -- not
# "make pushing hard", but "make skipping visible".
#
# SCOPE IS DELIBERATELY NARROW.  The dynamic half (`lua5.1 tests/run_tests.lua`,
# ~100 min, GH #124) is NOT here and is not claimed here; a wrapper whose name
# or banner claims more than it asserts is a trap this repo has already paid for
# (GH #198 §2).  This hook says exactly "the static half ran".
#
# Armed per container by tools/agent/arm_push_gate.sh, which 开工自检 calls --
# `core.hooksPath` is local config and does NOT travel with a clone, so a fresh
# container has it disarmed until the one command every stream already runs
# arms it.
#
# Exit 0 = push proceeds.  Exit 1 = push refused.
set -u

# git runs hooks from the top level of the working tree; the `cd` is belt and
# braces so the hook behaves the same when invoked by hand or by a test.
cd "$(dirname "$0")/.." 2>/dev/null || true

if [ "${RULE6_BYPASS:-}" = "1" ]; then
    printf 'RULE6_BYPASS=1 -- the static gate was SKIPPED, not passed.\n'
    printf '  This push carries an UNCHECKED iron rule 6 static half (Lua luacheck,\n'
    printf '  the fast python ratchets GH #616, AND the fast Lua test ratchets\n'
    printf '  GH #624). Say so in your report.\n'
    exit 0
fi

# ---------------------------------------------------------------------------
# THE MEMO (director ruling 2026-09-13, filed off the 09-12T22:2xZ 收尾追加).
#
# git runs this hook once per `git push` INVOCATION, and the mandated push path
# in .claude/rules/claude-code.md is two of them:
#
#     git push -u origin <branch> && git push origin HEAD:main
#
# so every attempt pays for the three legs TWICE on a byte-identical tree.
# Measured in a throwaway repo (bare remote, counting hook, one commit pushed
# to two refs): `hook invocations: 2`, same HEAD, same HEAD^{tree}.
#
# The cost of that is not the point; the RACE is.  09-12T22:2xZ: the gate runs
# ~7 minutes (fast Lua leg 380s, ~90%) while `main` moved every ~7 minutes, and
# `HEAD:main` was remote-rejected three times running -- never on a red, always
# on a ref race -- ~21 minutes for zero product, then out under RULE6_BYPASS.
# The push that loses that race is the second one, and the second one is the
# run that provably cannot answer a different question than the first.
#
# ⚠️ A hit is a REUSE, not a bypass, and rule6_memo.py's banner says so in the
# line you are meant to quote.  RULE6_BYPASS asserts nothing; a hit replays a
# reading that a real run of all three legs produced on THIS EXACT tree, with
# the working tree clean.  Every unavailability -- dirty tree, no origin/main,
# moved base, red or could-not-run last time -- is a MISS, never a hit; see the
# fail-closed list in tools/agent/rule6_memo.py.
#
# RULE6_NO_MEMO=1 forces the full three legs (use it when you want a second
# independent reading of the same tree).
# ---------------------------------------------------------------------------
if [ "${RULE6_NO_MEMO:-}" != "1" ]; then
    # Command substitution, NOT a pipe: `$?` here is python's own exit code.
    # (Iron-rule-3 hazard: this repo has misread an exit code through a pipe
    # 33 times. There is no `| tail` anywhere on this path, by construction.)
    memo_out=$(python3 tools/agent/rule6_memo.py get 2>/dev/null)
    memo_rc=$?
    if [ "$memo_rc" -eq 0 ]; then
        printf '%s\n' "$memo_out"
        exit 0
    fi
fi

# Readings are collected here so a green run can be memoized for its twin push.
RULE6_LOG=$(mktemp 2>/dev/null) || RULE6_LOG=""
if [ -n "$RULE6_LOG" ]; then
    trap 'rm -f "$RULE6_LOG"' EXIT
fi

# `tee` puts a pipe on the path, so the exit code is read from PIPESTATUS[0],
# never from `$?` (which would be tee's, and tee always succeeds -- that is
# precisely how a red gets read as green). Leg 1 also prints its own exit code
# as `GATE_EXIT=`, so it gets a second opinion below; the other two legs do not
# print theirs, which is why only this one can be cross-checked.
if [ -n "$RULE6_LOG" ]; then
    bash tools/agent/luacheck_gate.sh 2>&1 | tee -a "$RULE6_LOG"
    rc=${PIPESTATUS[0]}
    claimed=$(grep -E '^GATE_EXIT=' "$RULE6_LOG" | tail -1 | sed -e 's/^GATE_EXIT=\([0-9]*\).*/\1/')
    if [ -n "$claimed" ] && [ "$claimed" != "$rc" ]; then
        printf 'PUSH REFUSED -- leg 1 exit code disagrees with its own banner\n'
        printf '  (PIPESTATUS said %s, GATE_EXIT= said %s). Not a pass; re-run with\n' "$rc" "$claimed"
        printf '  RULE6_NO_MEMO=1 and report this.\n'
        exit 1
    fi
else
    bash tools/agent/luacheck_gate.sh
    rc=$?
fi

case "$rc" in
    0) : ;;
    3)
        printf 'PUSH REFUSED -- iron rule 6 static half is RED (see the warnings above).\n'
        printf '  Fix them, or push anyway with:  RULE6_BYPASS=1 git push ...\n'
        exit 1
        ;;
    *)
        # Uncertifiable (exit 2) refuses too, and that is the load-bearing
        # choice in this file.  "Could not run" reading as "allowed" is exactly
        # how GH #171's SKIP and GH #205's `Unable to locate package` both
        # became established facts: each was one unremarkable line with no
        # effect on any machine-readable channel.  Refusing puts the decision in
        # a human's hands; the bypass keeps it from stranding work (GH #113
        # measured what unlanded work costs).
        printf 'PUSH REFUSED -- iron rule 6 static half could NOT RUN (gate exit %d).\n' "$rc"
        printf '  That is not a pass. Buy it (apt-get install -y lua-check) or push with:\n'
        printf '    RULE6_BYPASS=1 git push ...   (and record the bypass in your report)\n'
        exit 1
        ;;
esac

# ---------------------------------------------------------------------------
# The FAST python ratchets (GH #616, director ruling 2026-09-08).
#
# Everything above this line is the LUA static half.  The python ratchets were
# in no push gate at all, so the only leg that ever ran them was the director's
# 开工自检 -- one stream out of five, every 2h.  Measured cost of that: a red
# sat on `main` ~2h (09-07 `test_bots_walk_farm_only.py`), ~20min (09-08
# `test_mutstand_restore_trap.py`), and 09-05 read SEVEN at once -- each time
# with the stream that tripped it already gone.  The ratchets were working;
# what was missing was the feedback reaching the author.
#
# Scope is the fast ones only.  `tests/run_py_tests.sh` carries legs like
# `test_selfcheck_lua_leg.py` (120s budget, GH #358) and stays where it is.
# Membership is decided by MEASURED SECONDS in tools/agent/py_gate_manifest.json,
# never by filename -- a name-based selector is the defect shape this repo has
# paid for repeatedly (a detector that knows one spelling calls the others
# absent).  Regenerate with:  python3 tools/agent/py_gate_measure.py
#
# Same 0/2/3 vocabulary, same refusal on BOTH 2 and 3, as the Lua half.
# ---------------------------------------------------------------------------
if [ -n "$RULE6_LOG" ]; then
    python3 tools/agent/py_gate.py 2>&1 | tee -a "$RULE6_LOG"
    prc=${PIPESTATUS[0]}   # NOT $? -- see the note on leg 1
else
    python3 tools/agent/py_gate.py
    prc=$?
fi

case "$prc" in
    0) : ;;
    3)
        printf 'PUSH REFUSED -- iron rule 6 python half is RED (see the FAIL lines above).\n'
        printf '  If the named test is not about your change, the red was ALREADY on trunk:\n'
        printf '  say so in your report and tell the owning stream (that notice is the whole\n'
        printf '  point of GH #616 -- before this, nobody but the director ever saw it).\n'
        printf '  Fix them, or push anyway with:  RULE6_BYPASS=1 git push ...\n'
        exit 1
        ;;
    *)
        printf 'PUSH REFUSED -- iron rule 6 python half could NOT RUN (gate exit %d).\n' "$prc"
        printf '  That is not a pass. See the lines above, or push with:\n'
        printf '    RULE6_BYPASS=1 git push ...   (and record the bypass in your report)\n'
        exit 1
        ;;
esac

# ---------------------------------------------------------------------------
# The fast LUA TEST ratchets (GH #624, director ruling 2026-09-10, option 1).
#
# Everything above this line either LINTS Lua (luacheck never executes a test
# body) or runs PYTHON.  The Lua censuses were in no push gate at all, and
# their failure mode is structural rather than accidental: a census asserts
# "the set of X in the corpus is exactly the set that has been read", so ANY
# stream landing a new gate, call site or ability instance turns one red.  The
# pusher's gate was silent; the NEXT stream to start work found it, hours
# later, with the author gone.  GH #624 counted four instances, and on the
# morning this landed THREE were red on `main` at once.
#
# Membership is decided by MEASURED SECONDS in tools/agent/lua_gate_manifest
# .json, never by filename -- GH #616 constraint 1, and the reason it matters
# more here: the tests this leg exists for are the EXPENSIVE ones (1.88s /
# 2.60s / 4.72s measured 2026-09-10), so a verbatim copy of the python half's
# 12s cheapest-first budget would have filled the gate with cheap tests, left
# out every test the issue was opened about, and still reported a healthy
# selected_count.  Regenerate with:  python3 tools/agent/lua_gate_measure.py
#
# ⚠️ SCOPE, stated rather than implied: this is NOT the Lua dynamic half.  The
# full suite is ~100 min in one process (GH #124) and stays where it is; the
# manifest names every test left out and why.
#
# Same 0/2/3 vocabulary, same refusal on BOTH 2 and 3, as the two legs above.
# ---------------------------------------------------------------------------
# SCOPE, computed here because only the hook knows what is being pushed.
# `git diff --name-only <base>..HEAD` against the remote's main; ANY failure or
# empty answer leaves `changed` empty, and lua_gate.py's --if-touched treats an
# empty list as RUN EVERYTHING.  The fail-open direction is the one that has
# cost this repo real reds, so it is not available here: skipping needs a
# positive answer, never the absence of one.
changed=$(git diff --name-only origin/main...HEAD 2>/dev/null) || changed=""

if [ -n "$RULE6_LOG" ]; then
    # shellcheck disable=SC2086 -- word splitting on the path list is intended
    python3 tools/agent/lua_gate.py --if-touched $changed 2>&1 | tee -a "$RULE6_LOG"
    lrc=${PIPESTATUS[0]}   # NOT $? -- see the note on leg 1
else
    # shellcheck disable=SC2086 -- word splitting on the path list is intended
    python3 tools/agent/lua_gate.py --if-touched $changed
    lrc=$?
fi

case "$lrc" in
    0)
        # All three legs green on this tree. Store the three verdict lines so
        # the twin push of the SAME tree replays them instead of re-earning
        # them. Only an all-green reading is ever stored: a red or a
        # could-not-run must always be re-run, so neither reaches this branch.
        if [ -n "$RULE6_LOG" ]; then
            readings=$(mktemp 2>/dev/null) || readings=""
            if [ -n "$readings" ]; then
                {
                    grep -E '^GATE_EXIT=' "$RULE6_LOG" | tail -1
                    grep -E '^py gate: ' "$RULE6_LOG" | tail -1
                    grep -E '^lua gate: ' "$RULE6_LOG" | tail -1
                } > "$readings" 2>/dev/null
                # Storage is best effort: a failure here costs the next push
                # seven minutes, never correctness, so it must not fail a push.
                python3 tools/agent/rule6_memo.py put "$readings" >/dev/null 2>&1
                rm -f "$readings"
            fi
        fi
        exit 0
        ;;
    3)
        printf 'PUSH REFUSED -- iron rule 6 fast LUA TEST leg is RED (see the FAIL lines above).\n'
        printf '  If the named test is a CENSUS and your change added a gate, call site or\n'
        printf '  ability instance, the census is asking you to register it -- that is the\n'
        printf '  test working, not breaking. If it is not about your change, the red was\n'
        printf '  ALREADY on trunk: say so in your report and tell the owning stream.\n'
        printf '  Fix them, or push anyway with:  RULE6_BYPASS=1 git push ...\n'
        exit 1
        ;;
    *)
        printf 'PUSH REFUSED -- iron rule 6 fast LUA TEST leg could NOT RUN (gate exit %d).\n' "$lrc"
        printf '  That is not a pass. See the lines above, or push with:\n'
        printf '    RULE6_BYPASS=1 git push ...   (and record the bypass in your report)\n'
        exit 1
        ;;
esac
