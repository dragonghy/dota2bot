IAM_PROFILE=dota2bot-batch-runner
SECURITY_GROUP=sg-044c4c8442366055e
INSTANCE_TYPE=c6i.4xlarge
AMI_ID=ami-0a990a26d89c66547
KEY_NAME=          # your EC2 keypair name (create one in the console if needed)
# [harness] #252: the AZ ring spot_run.sh rotates a wave over. Verified
# 2026-08-27 against this account: all four AZs are `available`, all four offer
# INSTANCE_TYPE (describe-instance-type-offerings), and the default VPC
# (vpc-5ffb3d27) has a DefaultForAz subnet in each, so `--placement
# AvailabilityZone=<az>` needs no subnet table. Leave EMPTY to restore the
# pre-#252 behavior (EC2 chooses -- which put four W17 instances in one AZ and
# lost all four to one capacity event). Drop an AZ from this list if it ever
# stops offering INSTANCE_TYPE; spot_run.sh does not re-verify at launch.
AZ_LIST=us-west-2a,us-west-2b,us-west-2c,us-west-2d
